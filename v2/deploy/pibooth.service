[Unit]
Description=piBooth photo booth (v2)
After=network-online.target systemd-user-sessions.service getty@tty1.service
Wants=network-online.target
Conflicts=getty@tty1.service

[Service]
User=booth
PAMName=login
TTYPath=/dev/tty1
StandardInput=tty
StandardOutput=journal
TTYReset=yes
TTYVHangup=yes
TTYVTDisallocate=yes
WorkingDirectory=/opt/pibooth
Environment=RUST_LOG=info
EnvironmentFile=-/opt/pibooth/.env
ExecStart=/usr/bin/cage -s -- /opt/pibooth/pibooth --config /opt/pibooth/config.toml
Restart=always
RestartSec=3

[Install]
WantedBy=multi-user.target
